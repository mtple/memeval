# Copy to .env and fill in only what you need. Nothing here is required for `make demo` or `make test`.

# Control-plane admin token (random one is printed by `market-replay serve` if unset)
MARKET_REPLAY_ADMIN_TOKEN=
# Where packs, runs and the SQLite control plane live (gitignored)
MARKET_REPLAY_DATA_DIR=./data
# Show actual episode dates for practice packs in the control plane (1) or hide them (0)
MARKET_REPLAY_DEV_MODE=1

# ---- Optional, read-only historical collection (opt-in; `make collect ARGS="--config ..."`) ----
# Name this variable in your collection config as rpc_url_env. Never put the URL in the config file.
BASE_RPC_URL=
# Optional CoinGecko/GeckoTerminal key for enrichment collectors (never used by tests or the demo)
COINGECKO_API_KEY=

# ---- Optional inference gateway for the model_client example (default: offline mock) ----
MARKET_REPLAY_INFERENCE_PROVIDER=mock
MARKET_REPLAY_INFERENCE_MODEL=mock-deterministic
# Default spend authorization is zero. A configured key does not authorize billable calls.
MARKET_REPLAY_INFERENCE_SPEND_LIMIT_USD=0
ANTHROPIC_API_KEY=
