    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "received_utc_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Received Utc Ms"
    },
    "request": {
      "additionalProperties": true,
      "title": "Request",
      "type": "object"
    },
    "requested_utc_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Requested Utc Ms"
    }
  },
  "required": [
    "receipt_id",
    "provider",
    "request",
    "http_status",
    "application_error",
    "body_sha256",
    "requested_utc_ms",
    "received_utc_ms"
